# ─────────────────────────────────────────────────────────────────────────────
# API environment. Copy to .env and fill in. NEVER commit the real .env.
# The process validates every variable at startup and refuses to boot if one is
# missing or malformed, so a typo here fails loudly rather than at 3am.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# PostgreSQL 18 running locally. Create the database first:
#   createdb booking_dev     (or)     CREATE DATABASE booking_dev;
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/booking_dev?schema=public

# Optional. Redis accelerates slot holds and backs the rate limiter, but the booking
# write path never reads it — PostgreSQL remains the authority on conflicts. Leave this
# unset and the app falls back to in-process implementations with identical behaviour.
# REDIS_URL=redis://localhost:6379

# Generate fresh values, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The two secrets MUST differ.
JWT_ACCESS_SECRET=replace-me-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-me-with-a-different-32-plus-character-value
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Must be true in production; the app refuses to start otherwise.
COOKIE_SECURE=false
# COOKIE_DOMAIN=example.com

FRONTEND_URL=http://localhost:3000
# Comma-separated. Defaults to FRONTEND_URL when unset.
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001

LOG_LEVEL=info

# console = print emails to the log. file = write .eml files to MAIL_OUTPUT_DIR.
# Both are development providers; a real transport plugs in behind the same interface.
EMAIL_PROVIDER=console
EMAIL_FROM=Bookings <no-reply@example.com>
MAIL_OUTPUT_DIR=./tmp/mail

# How long a slot stays held while the customer completes the booking form.
BOOKING_HOLD_TTL_SEC=600
# Grace period before a PENDING appointment past its hold is released.
PENDING_SWEEP_GRACE_SEC=120
OUTBOX_POLL_INTERVAL_MS=15000
# Set false to run the API without background pollers (used by the test suite).
ENABLE_BACKGROUND_JOBS=true

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Same-origin deploys: lax. Split api/web domains (most hosts): none, with COOKIE_SECURE=true.
COOKIE_SAMESITE=lax
