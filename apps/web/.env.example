# ─────────────────────────────────────────────────────────────────────────────
# Web client environment. Copy to .env.local.
# ─────────────────────────────────────────────────────────────────────────────

# Where the BROWSER sends API calls. Leave it relative: requests then go to this app's
# own origin and are proxied to the API (see next.config.ts), which keeps the session
# cookie first-party. Set an absolute URL only if you deliberately want the browser to
# talk to another domain — cookies will then be third-party and login will fail in
# Safari and in Chrome's default configuration.
# Baked into the client bundle at build time: changing it needs a rebuild, not a restart.
NEXT_PUBLIC_API_URL=/api/v1

# Where THIS SERVER sends API calls: server components, and the proxy above. Read at
# runtime, so these can change without a rebuild.
INTERNAL_API_URL=http://localhost:4000/api/v1
API_PROXY_TARGET=http://localhost:4000
